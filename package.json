{
  "name": "shared-device-lab",
  "private": true,
  "version": "0.1.0",
  "description": "Shared Android device lab: fair leases, live control, crash recovery",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"pnpm --filter @lab/server dev\" \"pnpm --filter @lab/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke-adb.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "demo": "tsx scripts/demo-four-clients.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\""
  },
  "devDependencies": {
    "@lab/device-adapter": "workspace:^",
    "@lab/protocol": "workspace:^",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.0",
    "ioredis": "^5.4.2",
    "prettier": "^3.4.2",
    "prom-client": "^15.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  }
}

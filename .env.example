# Server
PORT=4000
HOST=127.0.0.1
REDIS_URL=redis://127.0.0.1:6379

# Devices: comma-separated ADB serials to register (default: the three emulators)
DEVICE_SERIALS=emulator-5554,emulator-5556,emulator-5558

# Session lifecycle (ms)
SESSION_MAX_MS=600000
RESERVATION_CLAIM_MS=10000
HEARTBEAT_INTERVAL_MS=5000
HEARTBEAT_TIMEOUT_MS=15000
RECONNECT_GRACE_MS=15000
CLEANUP_TIMEOUT_MS=30000
DEVICE_HEALTH_INTERVAL_MS=5000
REAPER_INTERVAL_MS=2000

# Streaming
STREAM_MODE=auto            # auto | screenrecord | screencap
STREAM_FPS=15
STREAM_JPEG_QUALITY=7       # ffmpeg -q:v (2 best .. 31 worst)
STREAM_MAX_BUFFERED_BYTES=1000000

# Input
INPUT_MAX_TEXT_LENGTH=512
INPUT_MAX_PENDING=32

# Cross-origin deployment (unset for local same-origin dev)
CORS_ORIGINS=
# host:port targets to `adb connect` at boot (remote/tunneled devices)
ADB_CONNECT=

# Natural-language test console: optional LLM fallback for free-form phrasing.
# The deterministic parser handles common commands with no key; when a request
# it can't parse arrives and this key is set, the server (never the browser)
# asks OpenAI for a validated plan. Leave empty to disable the LLM fallback.
# In production, set via `flyctl secrets set OPENAI_API_KEY=...`, not this file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
